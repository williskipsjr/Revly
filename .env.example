# Copy to .env and adjust. .env is gitignored; .env.example is committed.

# --- PostgreSQL (single source of truth) ---
POSTGRES_USER=revrec
POSTGRES_PASSWORD=revrec_dev_pw
POSTGRES_DB=revrecovery
# Used by services inside the compose network (host = "postgres"):
DATABASE_URL=postgres://revrec:revrec_dev_pw@postgres:5432/revrecovery?sslmode=disable

# --- Redis (ephemeral coordination only; never authoritative) ---
REDIS_URL=redis://redis:6379/0

# --- Decision engine (Go: Decision + Execution planes) ---
DECISION_ENGINE_PORT=8080
SERVICE_VERSION=0.1.0
# HMAC-SHA256 secret for verifying inbound payment webhooks (PLAN §15).
# Empty in dev = verification DISABLED (a startup warning is logged). Set in any
# shared/staging environment. This is NOT a payment credential.
WEBHOOK_SECRET=

# Path to the trained P(success) logistic-regression artifact (Phase 3). Under compose it is
# mounted read-only into the container at this path; empty/missing = fall back to the Phase-2
# heuristic estimator (logged at startup). Regenerate with `python -m ml.train_success_model`.
SUCCESS_MODEL_PATH=/etc/decision-engine/success_model.json

# --- Diagnosis service (Python: Intelligence plane) ---
DIAGNOSIS_SERVICE_PORT=8000
DIAGNOSIS_SERVICE_URL=http://diagnosis-service:8000
# Phase 4: per-call timeout (ms) the decision-engine allows for an LLM diagnosis before it
# falls back to the deterministic rule table. Default 6000; must stay well under the ingest
# processing budget (15s) so a slow gateway degrades to rule-based rather than wedging ingestion.
DIAGNOSIS_TIMEOUT_MS=6000

# --- Dashboard (Next.js) ---
DASHBOARD_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- LLM inference gateway (Phase 4+) ---
# Only the diagnosis-service ever receives these — it has NO payment credentials. Inference goes
# through AgentRouter, an Anthropic-compatible gateway.
#   ANTHROPIC_BASE_URL   : gateway origin, WITHOUT a "/v1" suffix (the SDK appends the path).
#   ANTHROPIC_AUTH_TOKEN : the AgentRouter key. AgentRouter authenticates with a Bearer token, so
#                          this is sent as "Authorization: Bearer …". ANTHROPIC_API_KEY is accepted
#                          as an alias (repo's established name). Leave BOTH empty to run without an
#                          LLM: /internal/diagnose returns 503 and the Go engine uses the
#                          deterministic rule-based diagnosis (the pipeline never stalls).
ANTHROPIC_BASE_URL=https://agentrouter.org
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
