# Copy to .env and adjust. .env is gitignored; .env.example is committed.

# --- PostgreSQL (single source of truth) ---
POSTGRES_USER=revrec
POSTGRES_PASSWORD=revrec_dev_pw
POSTGRES_DB=revrecovery
# Used by services inside the compose network (host = "postgres"):
DATABASE_URL=postgres://revrec:revrec_dev_pw@postgres:5432/revrecovery?sslmode=disable

# --- Redis (ephemeral coordination only; never authoritative) ---
REDIS_URL=redis://redis:6379/0

# --- Decision engine (Go: Decision + Execution planes) ---
DECISION_ENGINE_PORT=8080
SERVICE_VERSION=0.1.0

# --- Diagnosis service (Python: Intelligence plane) ---
DIAGNOSIS_SERVICE_PORT=8000
DIAGNOSIS_SERVICE_URL=http://diagnosis-service:8000

# --- Dashboard (Next.js) ---
DASHBOARD_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- LLM (Phase 4+) ---
# NOTE: only the diagnosis-service ever receives this. It has NO payment credentials.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
