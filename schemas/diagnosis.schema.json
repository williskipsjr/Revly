{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://razorpay-buildathon.local/schemas/diagnosis.schema.json",
  "title": "Diagnosis",
  "description": "Output of the Diagnosis Service (LLM classifier or rule-based fallback). Advisory only: confidence is a gate, never the P(success) used in ERV.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "root_cause",
    "confidence",
    "rationale",
    "candidate_actions",
    "model_version"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "payment_event_id": { "type": ["string", "null"] },
    "root_cause": {
      "type": "string",
      "enum": [
        "temporary_bank_decline",
        "insufficient_funds",
        "expired_method",
        "checkout_abandonment",
        "chronic_failure",
        "fraud_suspected",
        "unknown"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Gating signal ONLY. Never used as P(success) inside ERV."
    },
    "rationale": { "type": "string", "minLength": 1 },
    "candidate_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/action" }
    },
    "model_version": { "type": "string" },
    "source": {
      "type": "string",
      "enum": ["llm", "rule_based_fallback"],
      "default": "llm"
    },
    "created_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "$defs": {
    "action": {
      "type": "string",
      "enum": [
        "retry",
        "delayed_retry",
        "alt_method",
        "payment_link",
        "notify",
        "escalate",
        "no_action"
      ]
    }
  }
}
